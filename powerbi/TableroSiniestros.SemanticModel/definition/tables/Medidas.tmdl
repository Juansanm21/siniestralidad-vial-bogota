table Medidas
	lineageTag: a806eeb8-2c92-9b5d-4c90-0abb862f12d0

	measure Fallecidos = CALCULATE(COUNTROWS(actor_vial), actor_vial[estado] = "Fallecido")
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: ee40f546-e0ed-b973-0514-bbcda2455cd0

	measure Lesionados = CALCULATE(COUNTROWS(actor_vial), actor_vial[estado] = "Herido")
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: fe09a73f-9621-eccf-e028-36a032458b3e

	measure Víctimas = [Fallecidos] + [Lesionados]
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: cc3a93ee-87f0-1d47-09d2-a9cbbe0a99cc

	measure Siniestros = COUNTROWS(siniestros)
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: 27a78ea0-ace2-bf4c-79ca-cf5746cfcd21

	measure 'Fallecidos AA' = CALCULATE([Fallecidos], SAMEPERIODLASTYEAR(Calendario[Fecha]), REMOVEFILTERS(Calendario))
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: 46796ac6-8754-be7c-3b12-85c4df4d5b83

	measure 'Lesionados AA' = CALCULATE([Lesionados], SAMEPERIODLASTYEAR(Calendario[Fecha]), REMOVEFILTERS(Calendario))
