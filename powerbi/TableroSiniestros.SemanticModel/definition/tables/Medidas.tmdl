	measure '% Moto madrugada' = DIVIDE(CALCULATE([Fallecidos], actor_vial[actor] = "Motociclista", siniestros[Hora_Acc] <= 5), CALCULATE([Fallecidos], actor_vial[actor] = "Motociclista"))
