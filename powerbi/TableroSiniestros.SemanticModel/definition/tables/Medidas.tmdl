		displayFolder: 2 Indicadores
		lineageTag: ea3f263d-f871-afe2-1def-5cb806e67002

	measure '% De noche' = DIVIDE(CALCULATE([Fallecidos], siniestros[dia_noche] = "Noche"), [Fallecidos])
