		lineageTag: 971a329e-69ca-1529-7922-98c13b1361b4

	measure 'Var Fallecidos' = DIVIDE([Fallecidos] - [Fallecidos AA], [Fallecidos AA])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 1 Base
		lineageTag: fd1ae275-e42c-baca-8e5f-7053cdbf4cb6

	measure 'Var Lesionados' = DIVIDE([Lesionados] - [Lesionados AA], [Lesionados AA])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 1 Base
		lineageTag: f90a926f-38dc-a626-dd6b-18d7b154510a

	measure 'Fallecidos por semana' = DIVIDE([Fallecidos], DIVIDE(COUNTROWS(Calendario), 7))
		formatString: 0.0
		displayFolder: 1 Base
		lineageTag: 7b4e0cf4-4bb0-a5ac-17dd-7393bdeb3525

	measure '% Motociclistas' = DIVIDE(CALCULATE([Fallecidos], actor_vial[actor] = "Motociclista"), [Fallecidos])
