	measure Titulo =
			VAR loc = IF(ISFILTERED(siniestros[Localidad]), SELECTEDVALUE(siniestros[Localidad], "varias localidades"), "Bogotá")
			VAR act = IF(ISFILTERED(actor_vial[actor]), SELECTEDVALUE(actor_vial[actor], "varios actores"), "todas las víctimas")
			VAR an = IF(ISFILTERED(Calendario[Año]), SELECTEDVALUE(Calendario[Año], "varios años") & "", "2015-2025")
			VAR corte = CALCULATE(MAX(siniestros[Fecha_Acc]), REMOVEFILTERS())
			RETURN loc & " · " & an & " · " & act & "  |  datos al " & FORMAT(corte, "dd/mm/yyyy")
		displayFolder: 4 Textos y colores
		lineageTag: e9473840-6b79-5920-7981-a77187a59ecc

	measure 'Top localidad' =
			VAR t = TOPN(1, FILTER(VALUES(siniestros[Localidad]), NOT ISBLANK([Fallecidos])), [Fallecidos], DESC)
			RETURN CONCATENATEX(t, siniestros[Localidad], ", ")
		displayFolder: 5 Lectura ejecutiva
		lineageTag: 7253f056-167f-cc5f-f792-79fb6b7e492f

	measure 'Top localidad detalle' =
			VAR loc = [Top localidad]
			VAR f = CALCULATE([Fallecidos], siniestros[Localidad] = loc)
			VAR n = CALCULATE([% De noche], siniestros[Localidad] = loc)
			RETURN FORMAT(f, "#,0") & " fallecidos · " & FORMAT(n, "0%") & " de noche"
		displayFolder: 5 Lectura ejecutiva
		lineageTag: bf0c2b1d-5cc1-abfe-ead7-c2f1fffbb2cf

	measure 'Mayor aumento' =
			VAR t = TOPN(1, FILTER(VALUES(siniestros[Localidad]), [Fallecidos AA] >= 5 && [Fallecidos] > [Fallecidos AA]), [Fallecidos] - [Fallecidos AA], DESC)
			RETURN IF(COUNTROWS(t) = 0, "Ninguna localidad aumentó", CONCATENATEX(t, siniestros[Localidad], ", "))
		displayFolder: 5 Lectura ejecutiva
		lineageTag: c8fa79d0-2305-aa78-bafc-8b73f6ffc9a6

	measure 'Mayor aumento detalle' =
			VAR loc = [Mayor aumento]
			VAR f = CALCULATE([Fallecidos], siniestros[Localidad] = loc)
			VAR aa = CALCULATE([Fallecidos AA], siniestros[Localidad] = loc)
			RETURN IF(ISBLANK(aa), "Elige un año para comparar", "De " & FORMAT(aa, "#,0") & " a " & FORMAT(f, "#,0") & " fallecidos frente al año anterior")
		displayFolder: 5 Lectura ejecutiva
		lineageTag: e97f8ce6-877d-5a76-e75a-594faa546d9a

	measure 'Mayor reducción' =
			VAR t = TOPN(1, FILTER(VALUES(siniestros[Localidad]), [Fallecidos AA] >= 5 && [Fallecidos] < [Fallecidos AA]), [Fallecidos AA] - [Fallecidos], DESC)
			RETURN IF(COUNTROWS(t) = 0, "Ninguna localidad bajó", CONCATENATEX(t, siniestros[Localidad], ", "))
		displayFolder: 5 Lectura ejecutiva
		lineageTag: a676dcfa-8d18-ec89-0cf3-f4b49e96ebff

	measure 'Mayor reducción detalle' =
			VAR loc = [Mayor reducción]
			VAR f = CALCULATE([Fallecidos], siniestros[Localidad] = loc)
			VAR aa = CALCULATE([Fallecidos AA], siniestros[Localidad] = loc)
			RETURN IF(ISBLANK(aa), "Elige un año para comparar", "De " & FORMAT(aa, "#,0") & " a " & FORMAT(f, "#,0") & " fallecidos frente al año anterior")
		displayFolder: 5 Lectura ejecutiva
		lineageTag: e0f556d3-9a60-4158-cb94-dcce23742e85

	measure 'Hora crítica' =
			VAR t = TOPN(1, FILTER(VALUES(siniestros[hora_txt]), NOT ISBLANK(siniestros[hora_txt]) && NOT ISBLANK([Fallecidos])), [Fallecidos], DESC)
			RETURN CONCATENATEX(t, siniestros[hora_txt], ", ")
		displayFolder: 5 Lectura ejecutiva
		lineageTag: 454b0202-208a-d227-f92f-fed236703737

	measure 'Hora crítica detalle' = "De noche mueren " & FORMAT([Letalidad noche], "0.0") & " de cada 100 víctimas; de día, " & FORMAT([Letalidad día], "0.0")
		displayFolder: 5 Lectura ejecutiva
		lineageTag: 4a446885-cd54-505a-f5ec-ad6972cfa322

	measure 'Color hora' =
			VAR h = SELECTEDVALUE(siniestros[Hora_Acc])
			RETURN IF(ISBLANK(h), "#C5CDD8", IF(h <= 5 || h >= 18, "#E8772E", "#C5CDD8"))
		displayFolder: 4 Textos y colores
		lineageTag: 57dd9e59-5feb-50a6-f7c7-15051a5a2a5c

	measure 'Color actor' = IF(SELECTEDVALUE(actor_vial[actor]) = "Motociclista", "#E8772E", "#C5CDD8")
		displayFolder: 4 Textos y colores
		lineageTag: 79737c1e-717f-9621-0d0b-2eeaecbcfc16

	measure 'Color vehículo' = IF(SELECTEDVALUE(vehiculos[Vehiculo_Viajaba_Clasificado]) = "CARGA", "#E8772E", "#C5CDD8")
		displayFolder: 4 Textos y colores
		lineageTag: 8087451b-7b7e-054e-be6e-5cc3d5b43c6a

	measure '% Siniestros mortales' =
			DIVIDE(CALCULATE(DISTINCTCOUNT(vehiculos[id_siniestro]), siniestros[Gravedad_indicador_30d] = "Con Muertos"),
			       CALCULATE(DISTINCTCOUNT(vehiculos[id_siniestro]), siniestros[Gravedad_indicador_30d] IN {"Con Muertos", "Con Heridos"}))
		formatString: 0.0%
		displayFolder: 2 Indicadores
		lineageTag: 938cd5eb-657f-6c49-0cca-fea2563363eb

	measure 'Titulo ficha' =
			VAR loc = IF(HASONEVALUE(siniestros[Localidad]), VALUES(siniestros[Localidad]), "Elige una localidad")
			VAR an = IF(HASONEVALUE(Calendario[Año]), VALUES(Calendario[Año]) & "", "2015-2025")
			RETURN "Ficha de localidad · " & loc & " · " & an
		displayFolder: 4 Textos y colores
		lineageTag: 985e1399-4852-c071-f20f-a81596f705e5

	partition Medidas = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    Quitada = Table.RemoveColumns(Origen, {"Columna1"})
				in
				    Quitada

	annotation PBI_ResultType = Table
