	measure 'Txt Fallecidos' =
			VAR aa = [Fallecidos AA]
			VAR v = [Var Fallecidos]
			RETURN IF(ISBLANK(aa), "Sin año anterior", IF(v > 0, "▲ ", "▼ ") & FORMAT(ABS(v), "0.0%") & " vs año anterior")
		displayFolder: 4 Textos y colores
		lineageTag: e2b6a917-19c0-7b92-03d3-07906832af91

	measure 'Color Txt Fallecidos' =
			VAR aa = [Fallecidos AA]
			RETURN IF(ISBLANK(aa), "#667085", IF([Fallecidos] > aa, "#D92D20", "#079455"))
		displayFolder: 4 Textos y colores
		lineageTag: cc7350cf-22a1-e7b7-2bcd-b6e74856892a

