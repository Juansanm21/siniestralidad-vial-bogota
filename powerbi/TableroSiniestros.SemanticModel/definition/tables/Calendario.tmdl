table Calendario
	lineageTag: 66acacc2-3cf1-b6d5-802f-8977bcb33830
	dataCategory: Time

	column Fecha
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Fecha
		lineageTag: cd8264db-8e0d-c3d6-3f44-c559eae7ad44

	column Año
		dataType: int64
		summarizeBy: none
		sourceColumn: Año
		lineageTag: cc9ddc0c-d608-071e-f993-6b8bd2146acd

	column MesNum
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: MesNum
		lineageTag: 5d30449b-c4e0-ac94-0b15-68049da277de

	column Mes
		dataType: string
		sortByColumn: MesNum
		summarizeBy: none
		sourceColumn: Mes
		lineageTag: 6162562c-48d8-84b7-85ff-093e4fedd507

	column DiaSemanaNum
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: DiaSemanaNum
		lineageTag: 008159b0-3031-1043-9f0c-f06136cbee75

	column DiaSemana
		dataType: string
		sortByColumn: DiaSemanaNum
		summarizeBy: none
		sourceColumn: DiaSemana
		lineageTag: c67ed455-04ec-d36c-9f2c-904d174809f6

	column FinDeSemana
		dataType: string
		summarizeBy: none
		sourceColumn: FinDeSemana
		lineageTag: bb59c264-6a5f-e8ae-9b2e-525efe5b3266

	partition Calendario = m
		mode: import
		source =
				let
				    Inicio = #date(2015, 1, 1),
				    Lista = List.Dates(Inicio, Duration.Days(#date(2025, 12, 31) - Inicio) + 1, #duration(1, 0, 0, 0)),
				    Tabla = Table.TransformColumnTypes(Table.FromList(Lista, Splitter.SplitByNothing(), {"Fecha"}), {{"Fecha", type date}}),
				    Anio = Table.AddColumn(Tabla, "Año", each Date.Year([Fecha]), Int64.Type),
				    MesNum = Table.AddColumn(Anio, "MesNum", each Date.Month([Fecha]), Int64.Type),
				    Mes = Table.AddColumn(MesNum, "Mes", each Text.Proper(Text.Start(Date.ToText([Fecha], "MMMM", "es-CO"), 3)), type text),
				    DiaNum = Table.AddColumn(Mes, "DiaSemanaNum", each Date.DayOfWeek([Fecha], Day.Monday) + 1, Int64.Type),
				    Dia = Table.AddColumn(DiaNum, "DiaSemana", each Text.Proper(Date.ToText([Fecha], "dddd", "es-CO")), type text),
				    Finde = Table.AddColumn(Dia, "FinDeSemana", each if [DiaSemanaNum] >= 5 then "Viernes a domingo" else "Lunes a jueves", type text)
				in
				    Finde

	annotation PBI_ResultType = Table
