	partition siniestros = m
		mode: import
		source =
				let
				    Binario = if Text.StartsWith(RutaDatos, "http") then Web.Contents(RutaDatos & "siniestros.csv.gz") else File.Contents(RutaDatos & "siniestros.csv.gz"),
				    Origen = Csv.Document(Binary.Decompress(Binario, Compression.GZip), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    SinBOM = Table.TransformColumnNames(Encabezados, each Text.Replace(_, Character.FromNumber(65279), "")),
				    Vacios = Table.TransformColumns(SinBOM, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"id_siniestro", type text}, {"Codigo_Accidente", Int64.Type}, {"Formulario", type text}, {"Longitud", type number}, {"Latitud", type number}, {"Direccion", type text}, {"Fecha_Acc", type date}, {"AA_Acc", Int64.Type}, {"MM_Acc", type text}, {"DD_Mes_Acc", Int64.Type}, {"Dia_Semana_Acc", type text}, {"Hora_Acc", Int64.Type}, {"Min_Acc", Int64.Type}, {"Localidad", type text}, {"Clase_Acc", type text}, {"Elemento_Choque", type text}, {"Tipo_Objeto_Fijo", type text}, {"Gravedad_Indicador_Tradicional", type text}, {"Gravedad_indicador_30d", type text}, {"Con_Bicicleta", type text}, {"Con_Carga", type text}, {"Con_Embriaguez", type text}, {"Con_Huecos", type text}, {"Con_Menores", type text}, {"Con_Moto", type text}, {"Con_Peaton", type text}, {"Con_Persona_Mayor", type text}, {"Con_Rutas", type text}, {"Con_Tpi", type text}, {"Con_Tpp", type text}, {"Con_Velocidad", type text}, {"Con_Sitp", type text}, {"Con_Troncal", type text}, {"Con_Alimentador", type text}, {"Con_Zonal", type text}, {"Con_Provisional", type text}, {"Con_Articulado", type text}, {"Con_Biarticulado", type text}, {"Con_Padron_Dual", type text}, {"Con_Servicio_Especial", type text}, {"Con_Taxi", type text}, {"anuario_origen", type text}}, "en-US"),
				    Banderas = Table.TransformColumns(Tipos, {{"Con_Bicicleta", each if _ = null then "NO" else _, type text}, {"Con_Carga", each if _ = null then "NO" else _, type text}, {"Con_Embriaguez", each if _ = null then "NO" else _, type text}, {"Con_Huecos", each if _ = null then "NO" else _, type text}, {"Con_Menores", each if _ = null then "NO" else _, type text}, {"Con_Moto", each if _ = null then "NO" else _, type text}, {"Con_Peaton", each if _ = null then "NO" else _, type text}, {"Con_Persona_Mayor", each if _ = null then "NO" else _, type text}, {"Con_Rutas", each if _ = null then "NO" else _, type text}, {"Con_Tpi", each if _ = null then "NO" else _, type text}, {"Con_Tpp", each if _ = null then "NO" else _, type text}, {"Con_Velocidad", each if _ = null then "NO" else _, type text}, {"Con_Sitp", each if _ = null then "NO" else _, type text}, {"Con_Troncal", each if _ = null then "NO" else _, type text}, {"Con_Alimentador", each if _ = null then "NO" else _, type text}, {"Con_Zonal", each if _ = null then "NO" else _, type text}, {"Con_Provisional", each if _ = null then "NO" else _, type text}, {"Con_Articulado", each if _ = null then "NO" else _, type text}, {"Con_Biarticulado", each if _ = null then "NO" else _, type text}, {"Con_Padron_Dual", each if _ = null then "NO" else _, type text}, {"Con_Servicio_Especial", each if _ = null then "NO" else _, type text}, {"Con_Taxi", each if _ = null then "NO" else _, type text}}),
				    Loc = Table.TransformColumns(Banderas, {{"Localidad", each if _ = null then "Sin información" else Text.Proper(_), type text}}),
				    HoraTxt = Table.AddColumn(Loc, "hora_txt", each if [Hora_Acc] = null then null else Text.PadStart(Text.From([Hora_Acc]), 2, "0") & " h", type text),
				    DiaNoche = Table.AddColumn(HoraTxt, "dia_noche", each if [Hora_Acc] = null then "Sin hora" else if [Hora_Acc] <= 5 or [Hora_Acc] >= 18 then "Noche" else "Día", type text),
				    Franja = Table.AddColumn(DiaNoche, "franja", each if [Hora_Acc] = null then "Sin hora" else if [Hora_Acc] <= 5 then "1 Madrugada (0-5 h)" else if [Hora_Acc] <= 11 then "2 Mañana (6-11 h)" else if [Hora_Acc] <= 17 then "3 Tarde (12-17 h)" else "4 Noche (18-23 h)", type text)
				in
				    Franja

	annotation PBI_ResultType = Table
