	partition actor_vial = m
		mode: import
		source =
				let
				    Binario = if Text.StartsWith(RutaDatos, "http") then Web.Contents(RutaDatos & "actor_vial.csv.gz") else File.Contents(RutaDatos & "actor_vial.csv.gz"),
				    Origen = Csv.Document(Binary.Decompress(Binario, Compression.GZip), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    SinBOM = Table.TransformColumnNames(Encabezados, each Text.Replace(_, Character.FromNumber(65279), "")),
				    Vacios = Table.TransformColumns(SinBOM, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"id_siniestro", type text}, {"Codigo_Accidentado", Int64.Type}, {"Codigo_Accidente", Int64.Type}, {"Formulario", type text}, {"Codigo_Vehiculo", Int64.Type}, {"Ccodigo_Victima", Int64.Type}, {"FechaAcc", type date}, {"AnnoAcc", Int64.Type}, {"mesAcc", type text}, {"DD_Mes_Acc", Int64.Type}, {"Dia_Semana_Acc", type text}, {"hourAcc", Int64.Type}, {"minuAcc", Int64.Type}, {"Localidad", type text}, {"Edad", Int64.Type}, {"Sexo", type text}, {"Gravedad_Indicador_Tradicional", type text}, {"Muerte_Posterior", type text}, {"Fecha_CambioGravedad", type date}, {"Gravedad_Indicador_30d", type text}, {"Condicion", type text}, {"Condicion_Especifica", type text}, {"Tipo_SITP", type text}, {"Con_Bicicleta", type text}, {"Con_Carga", type text}, {"Con_Embriaguez", type text}, {"Con_Huecos", type text}, {"Con_Menores", type text}, {"Con_Moto", type text}, {"Con_Peaton", type text}, {"Con_Persona_Mayor", type text}, {"Con_Rutas", type text}, {"Con_Tpi", type text}, {"Con_Tpp", type text}, {"Con_Velocidad", type text}, {"Con_Sitp", type text}, {"Con_Troncal", type text}, {"Con_Alimentador", type text}, {"Con_Zonal", type text}, {"Con_Provisional", type text}, {"Con_Articulado", type text}, {"Con_Biarticulado", type text}, {"Con_Padron_Dual", type text}, {"Con_Servicio_Especial", type text}, {"Con_Taxi", type text}, {"anuario_origen", type text}, {"victimaC", type text}, {"asociadoC", type text}}, "en-US"),
				    Banderas = Table.TransformColumns(Tipos, {{"Con_Bicicleta", each if _ = null then "NO" else _, type text}, {"Con_Carga", each if _ = null then "NO" else _, type text}, {"Con_Embriaguez", each if _ = null then "NO" else _, type text}, {"Con_Huecos", each if _ = null then "NO" else _, type text}, {"Con_Menores", each if _ = null then "NO" else _, type text}, {"Con_Moto", each if _ = null then "NO" else _, type text}, {"Con_Peaton", each if _ = null then "NO" else _, type text}, {"Con_Persona_Mayor", each if _ = null then "NO" else _, type text}, {"Con_Rutas", each if _ = null then "NO" else _, type text}, {"Con_Tpi", each if _ = null then "NO" else _, type text}, {"Con_Tpp", each if _ = null then "NO" else _, type text}, {"Con_Velocidad", each if _ = null then "NO" else _, type text}, {"Con_Sitp", each if _ = null then "NO" else _, type text}, {"Con_Troncal", each if _ = null then "NO" else _, type text}, {"Con_Alimentador", each if _ = null then "NO" else _, type text}, {"Con_Zonal", each if _ = null then "NO" else _, type text}, {"Con_Provisional", each if _ = null then "NO" else _, type text}, {"Con_Articulado", each if _ = null then "NO" else _, type text}, {"Con_Biarticulado", each if _ = null then "NO" else _, type text}, {"Con_Padron_Dual", each if _ = null then "NO" else _, type text}, {"Con_Servicio_Especial", each if _ = null then "NO" else _, type text}, {"Con_Taxi", each if _ = null then "NO" else _, type text}}),
				    Estado = Table.AddColumn(Banderas, "estado", each let g = Text.Upper(if [Gravedad_Indicador_30d] = null then "" else [Gravedad_Indicador_30d]) in if g = "MUERTO" then "Fallecido" else if g = "HERIDO" then "Herido" else if g = "ILESO" then "Ileso" else "Sin dato", type text),
				    Actor = Table.AddColumn(Estado, "actor", each let e = if [Condicion_Especifica] = null then "" else [Condicion_Especifica] in if List.Contains({"Motociclista", "Pasajero Motocicleta"}, e) then "Motociclista" else if e = "Peatón" then "Peatón" else if List.Contains({"Ciclista", "Pasajero Bicicleta"}, e) then "Ciclista" else "Ocupante de otro vehículo", type text),
				    Sexo = Table.TransformColumns(Actor, {{"Sexo", each if _ = null or Text.Upper(_) = "SIN INFORMACION" then "Sin información" else Text.Proper(_), type text}}),
				    Edad = Table.AddColumn(Sexo, "grupo_edad", each if [Edad] = null then "Sin dato" else if [Edad] < 18 then "0-17" else if [Edad] < 30 then "18-29" else if [Edad] < 45 then "30-44" else if [Edad] < 60 then "45-59" else "60 o más", type text)
				in
				    Edad

	annotation PBI_ResultType = Table
