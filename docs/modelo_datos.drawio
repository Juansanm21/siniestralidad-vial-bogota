<mxfile host="app.diagrams.net">
  <diagram id="modelo" name="Siniestros Bogotá">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b style=&quot;font-size:20px&quot;&gt;Siniestros viales de Bogotá — cómo se conectan las tablas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Fuente: Secretaría Distrital de Movilidad (SIGAT). Cada caja es una tabla; las flechas muestran la columna que las une.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1000" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s" value="SINIESTROS  ·  fact_siniestro&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;1 fila = 1 siniestro (informe policial)&lt;/span&gt;" style="swimlane;html=1;startSize=44;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="110" width="320" height="300" as="geometry" />
        </mxCell>
        <mxCell id="sf" value="&lt;b&gt;formulario&lt;/b&gt; — código del informe policial 🔑&lt;br&gt;codigo_accidente — código interno (une con VÍA)&lt;br&gt;fecha, anio, hora — cuándo pasó&lt;br&gt;franja — madrugada / mañana / tarde / noche&lt;br&gt;dia_semana, fin_de_semana&lt;br&gt;gravedad — con muertos / con heridos / solo daños&lt;br&gt;clase — choque, atropello, volcamiento…&lt;br&gt;localidad, barrio — dónde pasó&lt;br&gt;via_principal — ej. Avenida Boyacá&lt;br&gt;lat, lon — punto en el mapa" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;" vertex="1" parent="s">
          <mxGeometry y="44" width="320" height="256" as="geometry" />
        </mxCell>

        <mxCell id="v" value="VÍCTIMAS  ·  fact_victima&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;1 fila = 1 persona herida o fallecida&lt;/span&gt;" style="swimlane;html=1;startSize=44;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="110" width="320" height="230" as="geometry" />
        </mxCell>
        <mxCell id="vf" value="codigo_victima — código de la persona 🔑&lt;br&gt;formulario → SINIESTROS&lt;br&gt;codigo_vehiculo — en qué vehículo iba&lt;br&gt;estado — Fallecido / Herido&lt;br&gt;condicion — peatón, motociclista, ciclista…&lt;br&gt;genero, edad, grupo_edad&lt;br&gt;muerte_posterior — murió días después" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;" vertex="1" parent="v">
          <mxGeometry y="44" width="320" height="186" as="geometry" />
        </mxCell>

        <mxCell id="ve" value="VEHÍCULOS  ·  fact_vehiculo&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;1 fila = 1 vehículo involucrado&lt;/span&gt;" style="swimlane;html=1;startSize=44;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="420" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="vef" value="formulario → SINIESTROS&lt;br&gt;codigo_vehiculo — nº del vehículo en el informe&lt;br&gt;clase — motocicleta, automóvil, bus…&lt;br&gt;grupo_vehiculo — Moto / Automóvil / Bus / Camión…&lt;br&gt;servicio — particular, público…&lt;br&gt;en_fuga — el conductor huyó&lt;br&gt;&lt;i&gt;(la placa NO se descargó)&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;" vertex="1" parent="ve">
          <mxGeometry y="44" width="320" height="156" as="geometry" />
        </mxCell>

        <mxCell id="c" value="CAUSAS  ·  fact_causa&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;1 fila = 1 hipótesis del agente de tránsito&lt;/span&gt;" style="swimlane;html=1;startSize=44;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="110" width="330" height="170" as="geometry" />
        </mxCell>
        <mxCell id="cf" value="formulario → SINIESTROS&lt;br&gt;codigo_vehiculo — a qué vehículo se le atribuye&lt;br&gt;causa — ej. exceso de velocidad,&lt;br&gt;no mantener distancia, desobedecer señales&lt;br&gt;tipo — código de tipo de causa" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;" vertex="1" parent="c">
          <mxGeometry y="44" width="330" height="126" as="geometry" />
        </mxCell>

        <mxCell id="via" value="VÍA  ·  fact_via&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;1 fila = la vía principal del siniestro&lt;/span&gt;" style="swimlane;html=1;startSize=44;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="360" width="330" height="190" as="geometry" />
        </mxCell>
        <mxCell id="viaf" value="codigo_accidente → SINIESTROS&lt;br&gt;iluminacion — con / sin luz artificial&lt;br&gt;estado_via — bueno, con huecos…&lt;br&gt;condicion_via — seca, húmeda…&lt;br&gt;semaforo — sí / no&lt;br&gt;geometria — recta, curva…" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;" vertex="1" parent="via">
          <mxGeometry y="44" width="330" height="146" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="formulario" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;fontSize=11;" edge="1" parent="1" source="s" target="v"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="formulario" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;fontSize=11;exitX=0.25;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="s" target="ve"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="formulario" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;fontSize=11;" edge="1" parent="1" source="s" target="c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="codigo_accidente" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;fontSize=11;exitX=0.75;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="s" target="via"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="formulario + codigo_vehiculo&lt;br&gt;(en qué vehículo iba la víctima)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1;dashed=1;endArrow=open;fontSize=11;" edge="1" parent="1" source="v" target="ve"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="ley" value="&lt;b&gt;Cómo leerlo&lt;/b&gt;&lt;br&gt;🔑 = columna que identifica cada fila&lt;br&gt;Azul = el siniestro (tabla central)&lt;br&gt;Rojo, amarillo, morado, verde = detalle del siniestro&lt;br&gt;Línea punteada = relación secundaria&lt;br&gt;&lt;br&gt;&lt;b&gt;Periodo&lt;/b&gt;: 2015–2025 (años completos)" style="text;html=1;align=left;verticalAlign=top;strokeColor=#BFBFBF;fillColor=#FFFFFF;spacing=10;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="470" width="320" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
